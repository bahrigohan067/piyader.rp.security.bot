# ==========================================
# Piyader RP - Güvenlik Botu Yapılandırması
# ==========================================

# Discord Bot Token (Discord Developer Portal'dan alınır)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Korunacak Sunucunun ID'si (GİLD_İD / GUILD_ID)
GUILD_ID=1529545898294509589
GILD_ID=1529545898294509589

# Bot Sahibi / Ana Yönetici ID (Whitelist / Dokunulmazlık)
OWNER_ID=YOUR_OWNER_ID_HERE

# Güvenlik Log Kanalı ID'si
SECURITY_LOG_CHANNEL_ID=

# Karantina Rolü ID (İhlal yapanlara atanacak rol - opsiyonel)
QUARANTINE_ROLE_ID=

# Güvenli Kullanıcı ID'leri (Virgülle ayrılmış ID listesi)
WHITELIST_USERS=

# ==========================================
# Piyade RP Ekosistem Botları (WHITELIST)
# Mutual Denial of Service / Ban Çarpışmasını Önler
# ==========================================
# Virgülle ayrılmış toplu liste VEYA tek tek bot ID'leri:
WHITELIST_BOTS=

# 1. Ana Bot (piyade.rp.bot - /ban, /kick, ceza komutlarını yürüten bot)
PIYADE_BOT_ID=

# 2. Yapay Zeka Botu (piyade.rp.yapay.zeka.bot)
AI_BOT_ID=

# 3. Müzik Botu (piyade.rp.music.bot)
MUSIC_BOT_ID=

# 4. Oyun/ERLC Botu (piyade.rp.bot.1)
BOT_1_ID=

# 5. Rehber Botu (piyade.rp.bot.rehber)
REHBER_BOT_ID=
